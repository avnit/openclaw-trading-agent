# Anthropic API Key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenClaw / broker API credentials
OPENCLAW_API_KEY=your_openclaw_api_key_here
OPENCLAW_BASE_URL=https://api.public.com

# Optional: trading account ID (leave blank to auto-select first account)
OPENCLAW_ACCOUNT_ID=
